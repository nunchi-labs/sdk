{
  "name": "nunchi-wallet-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.content.config.ts && vite build --config vite.inpage.config.ts",
    "build:demo": "VITE_DEMO=1 npm run build",
    "build:wasm": "cd wasm-crypto && wasm-pack build --target web --out-dir ../src/wasm --release",
    "icons": "python3 scripts/prepare-store-assets.py",
    "package:store": "python3 scripts/package-store.py",
    "build:store": "npm run icons && npm run build:wasm && npm run build && npm run package:store",
    "preview": "vite preview",
    "postinstall": "node scripts/vite6-plugin-react-compat.mjs",
    "test": "vitest run --exclude src/**/*.live.test.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:selenium": "python3 scripts/selenium-e2e.py --extension dist"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3",
    "bech32": "^2.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "vite": "^6.4.5"
  }
}
